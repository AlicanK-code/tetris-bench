# Environments
.venv/
__pycache__/
*.py[cod]

# Secrets
.env

# Local instructions to Claude Code: the working-style preferences that used
# to live in CLAUDE.md, kept out of the public repo but still read here.
CLAUDE.local.md

# Personal Claude Code wiring. The notification hook under .claude/hooks/ is
# committed -- it holds no secret and is worth reading -- but what switches it
# on is not: this repo is public, and a hook that POSTs to a notification
# service on every prompt should not activate itself in someone else's clone.
.claude/settings.local.json

# Run outputs: JSONL logs and model-generated scoring functions.
#
# `runs/*` rather than `runs/`, because git does not descend into an excluded
# directory -- a negation inside one is never reached. Excluding the contents
# instead leaves the directory itself traversable, so the exception below works.
runs/*
!runs/published/

# Generated figures. Reproducible from a log with `analysis/plots.py`, so the
# PNGs are an output of the run rather than a source of it; committing them also
# risks a figure drawn from a synthetic or stale log outliving its data -- which
# already happened once, a 14B curve sitting here for two runs after the rungs
# it was missing had both been measured.
#
# This stays the scratch output directory. The figures the README shows live in
# runs/published/figures/ instead, beside the logs they are drawn from, so a
# commit that changes the data and a commit that changes the picture are the
# same commit. That is the structural fix for the staleness this comment warns
# about; keeping both means a figure can be redrawn freely without touching the
# published set.
analysis/figures/

# Tooling caches
.pytest_cache/
.ruff_cache/
.DS_Store
